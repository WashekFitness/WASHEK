# Browser-safe Supabase values. These are safe to expose in the frontend.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Optional frontend configuration.
VITE_SUPABASE_MEDIA_BUCKET=user-media
VITE_SUPABASE_AI_FUNCTION=ai-generate
VITE_SUPABASE_EMAIL_FUNCTION=send-contact-email

# Server-side secrets: DO NOT put these in .env or VITE_ variables.
# Set them in Supabase with: supabase secrets set --env-file .env.supabase
# OPENROUTER_API_KEY=...
# OPENROUTER_MODEL=openrouter/auto
# OPENROUTER_COST_TIER=high
# RESEND_API_KEY=...
# CONTACT_TO_EMAIL=washekfitness@gmail.com
# CONTACT_FROM_EMAIL=WASHEK <onboarding@resend.dev>
